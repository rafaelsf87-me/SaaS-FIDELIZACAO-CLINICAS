# ============================================================
# SUPABASE
# ============================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ============================================================
# LLM PROVIDER
# Valores: sonnet | openai
# ============================================================
LLM_PROVIDER=sonnet

# OpenAI (usado quando LLM_PROVIDER=openai ou para Whisper)
OPENAI_API_KEY=sk-...

# Claude/Anthropic (usado quando LLM_PROVIDER=sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# META WHATSAPP BUSINESS API
# ============================================================
META_WHATSAPP_TOKEN=seu-token-aqui
META_PHONE_NUMBER_ID=seu-phone-number-id
META_VERIFY_TOKEN=token-de-verificacao-webhook
META_APP_SECRET=seu-app-secret-meta

# Modo mock para desenvolvimento local (true/false)
WHATSAPP_MOCK=true

# ============================================================
# REDIS (BullMQ - Filas)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# APP
# ============================================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# ============================================================
# NEXT.JS (frontend)
# Prefixo NEXT_PUBLIC_ = exposto no browser
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
NEXT_PUBLIC_API_URL=http://localhost:3001
